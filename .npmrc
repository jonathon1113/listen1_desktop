; Listen1 Desktop 国内网络安装配置
; 作用：让 clone 后的 npm install 自动走镜像，避免 electron 二进制下载失败
;       导致 "Electron failed to install correctly"（node_modules/electron 缺 dist/path.txt）

; npm 包源（国内镜像，可按需注释掉改回官方源）
registry=https://registry.npmmirror.com

; electron 二进制镜像：node_modules/electron 的 postinstall 会下载 electron-v32.3.2-win32-x64.zip
; 读取方：@electron/get → npm_config_electron_mirror
electron_mirror=https://npmmirror.com/mirrors/electron/

; electron-builder 打包二进制镜像：nsis、winCodeSign、app-builder 等
; 读取方：app-builder-lib/out/binDownload.js → npm_config_electron_builder_binaries_mirror
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/
