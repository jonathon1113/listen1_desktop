{
    "parserOptions": {
        "ecmaVersion": 11
    },
    "extends": [
        "airbnb-base",
        "prettier"
    ],
    "rules": {
        "camelcase": "off",
        "linebreak-style": "off",
        "import/no-extraneous-dependencies": [
            "error",
            {
                "packageDir": ["..", "../.."],
                "devDependencies": true
            }
        ]
    },
    "globals": {
        "axios": "readonly",
        "window": "readonly",
        "browser": "readonly",
        "chrome": "readonly"
    },
    "env": {
        "browser": true,
        "node": false
    },
    "ignorePatterns": [
        "**/vendor/*.js"
    ]
}